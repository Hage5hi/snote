VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
# Set at the production cutover to its exact UTC timestamp + 30 days. Empty or
# malformed values deliberately disable legacy /s/:token compatibility.
VITE_LEGACY_SHARE_CUTOFF=""

# Capability note-route canary. Disabled unless explicitly approved.
VITE_CAPABILITY_ROUTES_ENABLED=false

# --- PWA readiness invalid-event reporter (optional, opt-in) ---
# Default: disabled. Set to "true" to install the sampled analytics reporter
# for `snote:pwa-readiness-invalid` in production builds.
VITE_PWA_READINESS_REPORTER_ENABLED=false
# Sampling rate 0..1 (only used when reporter is enabled). Default 0.01.
VITE_PWA_READINESS_REPORTER_SAMPLE_RATE=0.01
