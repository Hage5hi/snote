# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment variables — only ignore local overrides.
# `.env` is committed because it only contains VITE_* publishable
# (anon) keys that are designed to ship to the client; security is
# enforced via Supabase RLS, not by hiding the key. Committing it
# also keeps Lovable preview sandboxes working across resumes.
.env.local
.env.*.local

# Lockfiles from other package managers — project uses bun.lock.
# Prevents accidental drift when someone runs `npm install` or an old bun.
package-lock.json
yarn.lock
pnpm-lock.yaml
bun.lockb

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Playwright
/playwright-report/
/test-results/
**/test-results/
/playwright/.cache/
/e2e/*-snapshots/

# Generated audit and CI evidence
/artifacts/
/reports/
/coverage/
/.tmp/
/.worktrees/
*.pyc
__pycache__/

# Agent skills belong in the Lovable workspace. Keep only import-ready
# product skills under /lovable-skills/.
/.agents/
