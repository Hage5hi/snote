{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pi-ci/report-schema-validation-summary/v1",
  "title": "pi-ci report schema validation summary",
  "type": "object",
  "required": [
    "schema",
    "expected_schema_version",
    "out_dir",
    "files",
    "exit"
  ],
  "properties": {
    "schema": { "const": "pi-ci/report-schema-validation-summary/v1" },
    "expected_schema_version": { "type": "string", "minLength": 1 },
    "out_dir": { "type": "string" },
    "terminated_by": { "type": ["string", "null"] },
    "reason": { "type": "string" },
    "exit": { "type": ["integer", "null"] },
    "pi_ci_jq_bin": { "type": "string" },
    "jq_bin": { "type": "string" },
    "jq_version": { "type": "string" },
    "jq_cmdline": { "type": "string" },
    "jq_timeout_secs": { "type": "string" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "path",
          "expected_schema_version",
          "actual_schema_version",
          "status",
          "exit",
          "reason",
          "diff",
          "jq_stderr_excerpt",
          "jq_stderr_path"
        ],
        "properties": {
          "label": { "type": "string" },
          "path": { "type": "string" },
          "expected_schema_version": { "type": "string" },
          "actual_schema_version": { "type": "string" },
          "status": { "enum": ["OK", "FAIL"] },
          "exit": { "type": "integer" },
          "reason": {
            "enum": [
              "ok",
              "missing-file",
              "empty-file",
              "jq-missing",
              "jq-parse-failed",
              "jq-timeout",
              "schema_version-missing",
              "schema_version-empty",
              "schema_version-malformed",
              "schema-drift",
              "bad-env-var",
              "terminated"
            ]
          },
          "diff": { "type": ["object", "null"] },
          "jq_stderr_excerpt": { "type": ["string", "null"] },
          "jq_stderr_path": { "type": ["string", "null"] }
        }
      }
    }
  }
}
