{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://syrin.online/schemas/schema-drift-diff.schema.json",
  "title": "schema-drift diff --json output",
  "description": "Output shape produced by `bun scripts/schema-drift-diff.ts <before.json> <after.json> --json`. Fields are stable across runs when inputs are; anchors are recomputed via anchorFor() in scripts/schema-drift-pr-comment.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["totals", "added", "removed", "changed", "matchedAnchors"],
  "properties": {
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after", "added", "removed", "changed", "matched"],
      "properties": {
        "before": { "$ref": "#/definitions/reportTotals" },
        "after": { "$ref": "#/definitions/reportTotals" },
        "added": { "type": "integer", "minimum": 0 },
        "removed": { "type": "integer", "minimum": 0 },
        "changed": { "type": "integer", "minimum": 0 },
        "matched": { "type": "integer", "minimum": 0, "description": "Number of anchors present in both reports after applying filters. Equals matchedAnchors.length." }
      }
    },
    "added": {
      "type": "array",
      "items": { "$ref": "#/definitions/failureRef" }
    },
    "removed": {
      "type": "array",
      "items": { "$ref": "#/definitions/failureRef" }
    },
    "changed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "browser", "combined", "anchor", "missing", "extra", "mistyped", "parseError"],
        "properties": {
          "path": { "type": "string" },
          "browser": { "type": ["string", "null"] },
          "combined": { "type": "boolean" },
          "anchor": { "type": "string", "pattern": "^fail-[a-z0-9-]+$" },
          "missing": { "$ref": "#/definitions/addedRemoved" },
          "extra": { "$ref": "#/definitions/addedRemoved" },
          "mistyped": { "$ref": "#/definitions/addedRemoved" },
          "parseError": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["before", "after"],
                "properties": {
                  "before": { "type": ["string", "null"] },
                  "after": { "type": ["string", "null"] }
                }
              }
            ]
          }
        }
      }
    },
    "matchedAnchors": {
      "type": "array",
      "description": "Sorted, filtered list of #fail-<slug> anchors present in both reports.",
      "items": { "type": "string", "pattern": "^fail-[a-z0-9-]+$" }
    }
  },
  "definitions": {
    "reportTotals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checked", "invalid"],
      "properties": {
        "checked": { "type": "integer", "minimum": 0 },
        "invalid": { "type": "integer", "minimum": 0 }
      }
    },
    "failureRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "browser", "combined", "anchor"],
      "properties": {
        "path": { "type": "string" },
        "browser": { "type": ["string", "null"] },
        "combined": { "type": "boolean" },
        "anchor": { "type": "string", "pattern": "^fail-[a-z0-9-]+$" }
      }
    },
    "addedRemoved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["added", "removed"],
      "properties": {
        "added": { "type": "array", "items": { "type": "string" } },
        "removed": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
