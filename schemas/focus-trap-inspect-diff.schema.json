{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lovable.dev/schemas/focus-trap-inspect-diff.schema.json",
  "title": "focus-trap-inspect --diff-json-out",
  "description": "Machine-readable diff emitted by scripts/inspect-focus-trap.ts --diff-json-out. Rows are sorted by `file`. Consumers should pin against schemaVersion and reject any other value.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "generatedAt",
    "meta",
    "diffWith",
    "changed",
    "rows"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "generatedAt": { "type": "string" },
    "diffWith": { "type": "string" },
    "changed": { "type": "integer", "minimum": 0 },
    "meta": {
      "type": "object",
      "additionalProperties": true,
      "required": ["gitSha", "scanRoot", "argv", "timestamp"],
      "properties": {
        "gitSha": { "type": ["string", "null"] },
        "scanRoot": { "type": "string" },
        "invalidDir": { "type": ["string", "null"] },
        "argv": { "type": "array", "items": { "type": "string" } },
        "timestamp": { "type": "string" },
        "ciRunId": { "type": ["string", "null"] },
        "ciRunAttempt": { "type": ["string", "null"] }
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "prevFailureReason",
          "prevSchemaPointer",
          "currFailureReason",
          "currSchemaPointer"
        ],
        "properties": {
          "file": { "type": "string" },
          "prevFailureReason": { "type": "string" },
          "prevSchemaPointer": { "type": "string" },
          "currFailureReason": { "type": "string" },
          "currSchemaPointer": { "type": "string" }
        }
      }
    }
  }
}
