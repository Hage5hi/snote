* text=auto

# Reproducible source bytes and deterministic extension archives on every OS.
*.css text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

*.ico binary
*.jpg binary
*.png binary
*.webp binary
*.woff binary
*.woff2 binary
*.zip binary
