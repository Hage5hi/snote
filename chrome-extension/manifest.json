{
  "manifest_version": 3,
  "name": "Syrin Note — Side Panel",
  "version": "1.1.0",
  "minimum_chrome_version": "114",
  "description": "Open Syrin Note in a side panel — write and read your notes without leaving the page you're on.",
  "permissions": ["sidePanel", "storage"],
  "action": {
    "default_title": "Open Syrin Note",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "commands": {
    "open-side-panel": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "Open Syrin Note side panel"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
