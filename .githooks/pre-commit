#!/usr/bin/env bash
set -euo pipefail

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  cat <<'HELP'
Snote pre-commit hook

Runs the i18n allowlist check only when staged source or allowlist files can
affect the result. Set I18N_HOOK_FORCE=1 to run it for every commit.
Use git commit --no-verify only for local work-in-progress, never for release.
HELP
  exit 0
fi

STAGED="$(git diff --cached --name-only --diff-filter=ACMR || true)"

if [ "${I18N_HOOK_FORCE:-0}" != "1" ]; then
  if [ -z "$STAGED" ] || ! printf '%s\n' "$STAGED" | grep -Eq \
    -e '^(locales|i18n|src/i18n)/.+\.(json|tsx?|jsx?)$' \
    -e '^\.lintrc-i18n-allowlist(\.schema)?\.json$' \
    -e '^src/.+\.(t|j)sx?$'; then
    echo "pre-commit: no i18n-relevant staged files"
    exit 0
  fi
fi

echo "pre-commit: checking i18n allowlist"
bun run i18n:allowlist --changed
