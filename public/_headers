# Cloudflare Pages/static-assets fallback headers config.
#
# SOURCE OF TRUTH FOR PROD: cloudflare-worker/worker.js. This file and
# vercel.json are defense-in-depth fallbacks for static hosts that explicitly
# honor their respective formats.
#
# This fallback format cannot safely express the Worker's fingerprint regex,
# so it deliberately does not apply an immutable blanket to /assets/*. The
# Worker alone grants immutable caching to verified content-addressed names.
# index.html, the service worker, its loader, the web manifest, and the
# version.json heartbeat stay no-cache so update detection works on reload.


/*
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; form-action 'self'; frame-ancestors 'self' chrome-extension://*; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://flagcdn.com https://pub-bb2e103a32db4e198524a2e9ed8f35b4.r2.dev; font-src 'self' data:; connect-src 'self' https://onfzjmfjldsbthchssfr.supabase.co wss://onfzjmfjldsbthchssfr.supabase.co https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests;
  Permissions-Policy: camera=(), geolocation=(), microphone=(), payment=()

/
  Cache-Control: no-cache, must-revalidate

/index.html
