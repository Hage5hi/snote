  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:check": "vite build && bun run scripts/check-bundle-size.ts",
    "build:dev": "vite build --mode development",
    "lint": "eslint . --max-warnings 0",
    "knip": "knip",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:e2e:update:scene": "playwright test e2e/home-scenes-visual.spec.ts e2e/home-scene.spec.ts --update-snapshots",
    "test:e2e:update:changed": "bun run scripts/e2e-update-changed-scenes.ts",
    "test:e2e:changed": "bun run scripts/e2e-run-changed-scenes.ts",
    "test:e2e:summary": "bun run scripts/ci-e2e-summary.ts test-results/e2e-results.json",
    "test:e2e:debug:install": "PWDEBUG=${PWDEBUG:-0} DEBUG=${DEBUG:-pw:api} PWTEST_SLOW_MO=${SLOWMO:-150} ./scripts/debug-install-prompt-focus.sh",
    "test:e2e:inspect:focus-trap": "bun run scripts/inspect-focus-trap.ts",
    "test:e2e:replay:focus-trap": "./scripts/replay-focus-trap.sh",
    "schema:types": "bun run scripts/generate-focus-trap-schema-types.ts",
    "schema:types:check": "bun run scripts/generate-focus-trap-schema-types.ts && git diff --exit-code -- scripts/_helpers/focus-trap-inspect-schema.types.gen.ts",
    "schema-guard": "./scripts/schema-guard.sh",
    "theme:isolation": "bun run scripts/check-home-theme-isolation.ts",
    "i18n:check": "bun run scripts/i18n-coverage.ts",
    "i18n:audit": "bun run scripts/i18n-audit.ts",
    "i18n:allowlist": "bun run scripts/i18n-allowlist-check.ts",
    "i18n:allowlist:report": "bun run scripts/i18n-allowlist-report.ts",
    "i18n:allowlist:summary": "bun run scripts/i18n-allowlist-report.ts",
    "i18n:allowlist:pr-comment": "bun run scripts/i18n-allowlist-pr-comment.ts",
    "hooks:install": "git config core.hooksPath .githooks && echo '✅ git hooks installed (.githooks/)'",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
